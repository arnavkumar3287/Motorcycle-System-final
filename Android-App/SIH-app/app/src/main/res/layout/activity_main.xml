<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Header Status Indicator -->
    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="● SYSTEM ACTIVE (EDGE AI)"
        android:textColor="#888888"
        android:textSize="14sp"
        android:letterSpacing="0.1" />

    <!-- Primary Dynamic Shift Cue Indicator -->
    <TextView
        android:id="@+id/txtShiftCue"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#111111"
        android:gravity="center"
        android:text="🟢 HOLD"
        android:textColor="#00FF66"
        android:textSize="54sp"
        android:textStyle="bold"
        android:elevation="4dp" />

    <!-- Primary Live Telemetry (RPM & Gear) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENGINE RPM"
                android:textColor="#777777"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtRPM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4,500"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CURRENT GEAR"
                android:textColor="#777777"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtGear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"
                android:textColor="#00E5FF"
                android:textSize="32sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:background="#222222" />

    <!-- Secondary Telemetry (Load & Target RPM) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENGINE LOAD"
                android:textColor="#777777"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtLoad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="62%"
                android:textColor="#DDDDDD"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TARGET SHIFT"
                android:textColor="#777777"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTargetRPM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5,800 RPM"
                android:textColor="#DDDDDD"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>